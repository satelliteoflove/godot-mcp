{
  "name": "godot_tilemap",
  "description": "Query and edit TileMapLayer data: list layers, get info, get/set cells, convert coordinates",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "list_layers",
          "get_info",
          "get_tileset_info",
          "get_used_cells",
          "get_cell",
          "get_cells_in_region",
          "convert_coords",
          "set_cell",
          "erase_cell",
          "clear_layer",
          "set_cells_batch"
        ],
        "description": "list_layers: List TileMapLayer nodes in the scene\nget_info: Get TileMapLayer info\nget_tileset_info: Get the layer's TileSet info\nget_used_cells: Get all used cells\nget_cell: Get a single cell\nget_cells_in_region: Get cells within a rectangular region\nconvert_coords: Convert between local position and map coordinates\nset_cell: Set a single cell\nerase_cell: Erase a single cell\nclear_layer: Clear all cells in the layer\nset_cells_batch: Set many cells at once"
      },
      "root_path": {
        "description": "Starting node path (defaults to scene root) (for: list_layers)",
        "type": "string"
      },
      "node_path": {
        "type": "string",
        "description": "Path to the TileMapLayer (required for: get_info, get_tileset_info, get_used_cells, get_cell, get_cells_in_region, convert_coords, set_cell, erase_cell, clear_layer, set_cells_batch)"
      },
      "coords": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false,
        "description": "Cell coordinates (required for: get_cell, set_cell, erase_cell)"
      },
      "min_coords": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false,
        "description": "Minimum corner of region (required for: get_cells_in_region)"
      },
      "max_coords": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false,
        "description": "Maximum corner of region (required for: get_cells_in_region)"
      },
      "local_position": {
        "description": "Local position to convert to map coords (for: convert_coords)",
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "map_coords": {
        "description": "Map coordinates to convert to local position (for: convert_coords)",
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "source_id": {
        "description": "TileSet source ID, default 0 (for: set_cell)",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "atlas_coords": {
        "description": "Atlas coordinates, default 0,0 (for: set_cell)",
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "y": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "alternative_tile": {
        "description": "Alternative tile ID, default 0 (for: set_cell)",
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "cells": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "coords": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "source_id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "atlas_coords": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            },
            "alternative_tile": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "coords"
          ],
          "additionalProperties": false
        },
        "description": "Array of cells to set (required for: set_cells_batch)"
      }
    },
    "required": [
      "action"
    ]
  },
  "annotations": {
    "title": "TileMapLayer",
    "readOnlyHint": false,
    "destructiveHint": true,
    "openWorldHint": false
  }
}
